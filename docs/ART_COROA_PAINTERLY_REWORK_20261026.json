{
  "title": "Lote pictórico de Coroa III — Magistrada, Suserano e Príncipe",
  "date": "2026-10-26",
  "world": "Inferno",
  "elo": "Coroa",
  "style": "Pintura digital pictórica matte com pinceladas visíveis, planos de cor pintados, sombras manuais e contornos expressivos; anime 2.5D com composição cinematográfica, sem acabamento fotográfico ou CGI polido.",
  "gameplayChanged": false,
  "identities": [
    {
      "characterId": "a-juiza-de-ferro",
      "name": "A Magistrada",
      "identity": "Magistrada infernal adulta de pele clara, bob curto prateado com uma trança estreita, olhos âmbar; máscara de ferro preta com fendas verticais, gola alta assimétrica de placas, robe oxblood sobre armadura de carvão e algema quebrada acorrentada ao antebraço. Tirânica e cruel.",
      "setting": "Tribunal de basalto, cofres de provas vazios, grades de ferro e janelas estreitas cor de brasa."
    },
    {
      "characterId": "o-trono-vazio",
      "name": "O Suserano",
      "identity": "Presença espectral sem rosto ou corpo humano comum: capuz negro vazio com fenda âmbar estreita, coroa prateada quebrada flutuante, manto vinho profundo, placas de ferro negro como espaldar e correntes finas de prata no peito. Nunca é uma cadeira literal; autoridade coerciva e maliciosa.",
      "setting": "Salão imperial de basalto frio, arcadas vazias e planos arquitetônicos impossíveis no Inferno/Coroa."
    },
    {
      "characterId": "o-principe-das-correntes",
      "name": "O Príncipe",
      "identity": "Jovem adulto de pele marrom, cachos pretos curtos e apertados, uma trança longa clara atrás da orelha, olhos âmbar-dourados e pequeno piercing prateado na sobrancelha. Atlético, casaco preto com forro vinho sobre camisa marfim e corrente pesada de ferro contínua atravessada nos ombros; postura cruel e arrogante.",
      "setting": "Pontes molhadas de basalto, torres de vigia, pátio de moeda abandonado, cisterna dinástica e portões de ferro sob céu de cinzas."
    }
  ],
